#!/bin/sh
# postrm for forja. `remove` leaves data and keys alone; only `purge` deletes them.
#
# purge is DESTRUCTIVE: it deletes every hosted account (home, sites, databases, containers),
# the local restic repositories and /etc/forja/master.key. Set FORJA_PURGE_KEEP_DATA=1 to purge
# the package but keep users, data and keys:
#   FORJA_PURGE_KEEP_DATA=1 dpkg --purge forja
set -e

have_systemd() { [ -d /run/systemd/system ]; }

case "$1" in
remove)
    if have_systemd; then
        systemctl daemon-reload || true
    fi
    ;;

purge)
    if [ -n "${FORJA_PURGE_KEEP_DATA:-}" ]; then
        echo "forja: FORJA_PURGE_KEEP_DATA set: keeping users, data and keys" >&2
    else
        # Account users (fj-<slug>, home under /srv/forja/accounts) with their lingering
        # containers, created by the agent. Do not touch any other fj-* user.
        getent passwd | while IFS=: read -r name _ _ _ _ home _; do
            case "$name" in
            fj-*)
                case "$home" in
                /srv/forja/accounts/*)
                    if command -v loginctl >/dev/null 2>&1; then
                        loginctl disable-linger "$name" 2>/dev/null || true
                        loginctl terminate-user "$name" 2>/dev/null || true
                    fi
                    userdel "$name" 2>/dev/null || true
                    ;;
                esac
                ;;
            esac
        done

        if getent passwd forja >/dev/null; then
            userdel forja 2>/dev/null || true
        fi
        if getent group forja >/dev/null; then
            groupdel forja 2>/dev/null || true
        fi
        if getent group forja-agent >/dev/null; then
            groupdel forja-agent 2>/dev/null || true
        fi

        rm -rf /var/lib/forja /srv/forja /etc/forja /run/forja /opt/forja

        # Generated by postinst, never shipped in the package (so dpkg does not remove it).
        # It only holds FORJA_SECRET_KEY: useless without panel.db, but it is a secret.
        rm -rf /etc/systemd/system/forja-panel.service.d
    fi

    if have_systemd; then
        systemctl daemon-reload || true
    fi
    ;;

upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;

*)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
